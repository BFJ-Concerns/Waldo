#!/usr/bin/env bash
# The repository's quality gate: every check CI runs, in one command, so a
# contributor sees locally exactly what a push will see. Exit status is
# non-zero when any stage fails. Stages run in order and the first failure
# stops the run; pass --all to run every stage regardless and report at the
# end, which is how CI runs it so one red stage never hides another. Pass
# --check to run the static stages only (everything but the test suite), the
# minutes-cheap check to repeat while iterating on a change.
#
# Live-session tests (screencopy, Niri IPC, virtual input, clipboard, AT-SPI)
# skip themselves when no graphical session is present; run this inside the
# Niri session to include them.
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

run_all=false
check_only=false
for arg in "$@"; do
    case "$arg" in
        --all) run_all=true ;;
        --check) check_only=true ;;
        *)
            printf 'usage: scripts/gate [--all] [--check]\n' >&2
            exit 2
            ;;
    esac
done

failed=()
stage() {
    local name="$1"
    shift
    printf '\n==> %s\n' "$name"
    if "$@"; then
        return 0
    fi
    failed+=("$name")
    if [[ "$run_all" == false ]]; then
        printf '\nGate failed at: %s\n' "$name" >&2
        exit 1
    fi
    return 0
}

verify_service_file() {
    # The unit is a template: install-local replaces its ExecStart with the
    # installed waldod. systemd-analyze refuses an ExecStart that is not
    # executable, so verify against a private home holding a stub at the
    # template's path; the check then covers the unit, not whether Waldo
    # happens to be installed. systemd-analyze also needs a runtime
    # directory; give it a private one when the environment has none.
    local scratch
    scratch="$(mktemp -d)"
    install -d "$scratch/home/.cargo/bin"
    printf '#!/bin/sh\n' >"$scratch/home/.cargo/bin/waldod"
    chmod 0755 "$scratch/home/.cargo/bin/waldod"
    local runtime="${XDG_RUNTIME_DIR:-}"
    if [[ -z "$runtime" || ! -d "$runtime" ]]; then
        runtime="$scratch/runtime"
        install -d -m 0700 "$runtime"
    fi
    local status=0
    HOME="$scratch/home" XDG_RUNTIME_DIR="$runtime" \
        systemd-analyze --user --man=no --generators=no \
        verify packaging/waldod.service || status=$?
    # A failed clean-up fails the stage too, keeping any earlier status.
    if ! rm -rf -- "$scratch"; then
        printf 'could not remove the service check scratch directory %s\n' "$scratch" >&2
        [[ "$status" -ne 0 ]] || status=1
    fi
    return "$status"
}

stage "cargo fmt --check" cargo fmt --all --check
stage "cargo check" cargo check --workspace --all-targets
stage "clippy (warnings denied)" cargo clippy --workspace --all-targets -- -D warnings
stage "systemd-analyze verify" verify_service_file
if [[ "$check_only" == false ]]; then
    stage "cargo test" cargo test --workspace
    stage "Python launcher tests" python3 -m unittest discover -s scripts/tests -v
fi

if [[ ${#failed[@]} -gt 0 ]]; then
    printf '\nGate failed at: %s\n' "${failed[*]}" >&2
    exit 1
fi
if [[ "$check_only" == true ]]; then
    printf '\nCheck stages passed; the test suite was not run.\n'
else
    printf '\nGate passed.\n'
fi
