#!/usr/bin/env bash
set -eEuo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# These steps can be sourced to inspect configuration and generate a unit
# without installing binaries or changing a running service.
resolve_installation() {
    operator_home="$HOME"
    operator_codex_home="${CODEX_HOME:-$operator_home/.codex}"
    install_root="${WALDO_INSTALL_ROOT:-}"
    install_mode="canonical"
    marketplace_name="${WALDO_MARKETPLACE_NAME:-personal}"
    marketplace_owner="${WALDO_MARKETPLACE_OWNER:-BFJ Concerns}"

    if [[ -n "$install_root" ]]; then
        install_mode="redirected"
        install_root="$(realpath -m -- "$install_root")"
        case "$install_root" in
            /|"$operator_home"|"$repo_root")
                printf 'WALDO_INSTALL_ROOT must name a dedicated disposable directory.\n' >&2
                return 1
                ;;
        esac
        install_home="$install_root/home"
        cargo_root="${WALDO_CARGO_INSTALL_ROOT:-$install_root/cargo}"
        plugin_home="${WALDO_PLUGIN_HOME:-$install_home/plugins/waldo}"
        marketplace="${WALDO_MARKETPLACE:-$install_home/.agents/plugins/marketplace.json}"
        service_file="${WALDO_SERVICE_FILE:-$install_home/.config/systemd/user/waldod.service}"
        profile_file="${WALDO_PROFILE_FILE:-$install_root/state/waldo/environment.json}"
        codex_home="${WALDO_CODEX_HOME:-$install_root/codex}"
        runtime_tag="$(printf '%s' "$install_root" | sha256sum | cut -c1-12)"
        redirected_runtime="${WALDO_RUNTIME_DIR:-$XDG_RUNTIME_DIR/waldo-install-$runtime_tag}"
        # The rehearsal default is an explicit override for every child,
        # including MCP. Canonical resolution is left entirely to Settings.
        if [[ ! -v WALDO_SOCKET_PATH ]]; then
            export WALDO_SOCKET_PATH="$redirected_runtime/waldo/controller.sock"
        fi
        export XDG_CONFIG_HOME="$install_home/.config"
    else
        install_home="$operator_home"
        cargo_root="${WALDO_CARGO_INSTALL_ROOT:-${CARGO_INSTALL_ROOT:-${CARGO_HOME:-$operator_home/.cargo}}}"
        plugin_home="${WALDO_PLUGIN_HOME:-$operator_home/plugins/waldo}"
        marketplace="${WALDO_MARKETPLACE:-$operator_home/.agents/plugins/marketplace.json}"
        service_file="${WALDO_SERVICE_FILE:-$operator_home/.config/systemd/user/waldod.service}"
        profile_file="${WALDO_PROFILE_FILE:-${XDG_STATE_HOME:-$operator_home/.local/state}/waldo/environment.json}"
        codex_home="$operator_codex_home"
        redirected_runtime=""
    fi
    cargo_root="$(realpath -m -- "$cargo_root")"
    bin_dir="$cargo_root/bin"
    waldod_bin="$bin_dir/waldod"
    waldo_bin="$bin_dir/waldo"
    mcp_bin="$bin_dir/waldo-mcp"
}

# systemd expands specifiers in these directives. Quote the entire argument
# and escape input rather than letting paths become unit syntax.
systemd_argument() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//%/%%}"
    value="${value//$'\n'/\\n}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\t'/\\t}"
    printf '"%s"' "$value"
}

write_service_file() {
    local line
    install -d -m 0755 "$(dirname -- "$service_file")"
    while IFS= read -r line; do
        if [[ "$line" == ExecStart=* ]]; then
            printf 'ExecStart='
            # The executable path does not undergo environment expansion.
            systemd_argument "$waldod_bin"
            printf '\n'
            if [[ -v WALDO_SOCKET_PATH ]]; then
                printf 'Environment='
                systemd_argument "WALDO_SOCKET_PATH=$WALDO_SOCKET_PATH"
                printf '\n'
            fi
            if [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
                printf 'Environment='
                systemd_argument "XDG_CONFIG_HOME=$XDG_CONFIG_HOME"
                printf '\n'
            fi
        else
            printf '%s\n' "$line"
        fi
    done <"$repo_root/packaging/waldod.service" >"$service_file"
    chmod 0644 "$service_file"
}

write_codex_marketplace() {
    install -d -m 0755 "$(dirname -- "$marketplace")"
    local marketplace_tmp
    marketplace_tmp="$(mktemp)"
    if [[ -f "$marketplace" ]]; then
        jq --arg source "$marketplace_source" --arg name "$marketplace_name" --arg owner "$marketplace_owner" \
            '.name = $name
            | .owner = {"name":$owner}
            | .interface = (.interface // {"displayName":"Personal"})
            | .plugins = ((.plugins // []) | map(select(.name != "waldo")) + [{
                "name":"waldo",
                "source":{"source":"local","path":$source},
                "policy":{"installation":"AVAILABLE","authentication":"ON_INSTALL"},
                "category":"Productivity"
            }])' "$marketplace" >"$marketplace_tmp"
    else
        jq -n --arg source "$marketplace_source" --arg name "$marketplace_name" --arg owner "$marketplace_owner" '{
            "name":$name,
            "owner":{"name":$owner},
            "interface":{"displayName":"Personal"},
            "plugins":[{
                "name":"waldo",
                "source":{"source":"local","path":$source},
                "policy":{"installation":"AVAILABLE","authentication":"ON_INSTALL"},
                "category":"Productivity"
            }]
        }' >"$marketplace_tmp"
    fi
    install -m 0644 "$marketplace_tmp" "$marketplace"
    rm -f -- "$marketplace_tmp"
}

run_codex() {
    if [[ "$install_mode" == redirected ]]; then
        env HOME="$install_home" CODEX_HOME="$codex_home" PATH="$bin_dir:$PATH" "$@"
    else
        env PATH="$bin_dir:$PATH" "$@"
    fi
}

wait_for_controller() {
    local query_destination="$1"
    for _ in {1..50}; do
        if "$waldo_bin" query >"$query_destination" 2>/dev/null \
            && jq -e '.type == "queried"' "$query_destination" >/dev/null; then
            return 0
        fi
        sleep 0.1
    done
    printf 'Waldo controller did not answer the installed CLI query.\n' >&2
    return 1
}

# Installation entry point. Sourcing exposes only the resolution/write steps.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
fi

for command in cargo codex git jq realpath rsync sha256sum systemctl; do
    command -v "$command" >/dev/null || {
        printf 'Waldo installation requires %s on PATH.\n' "$command" >&2
        exit 1
    }
done

if [[ -z "${XDG_RUNTIME_DIR:-}" || -z "${WAYLAND_DISPLAY:-}" || -z "${NIRI_SOCKET:-}" ]]; then
    printf 'Run the installer inside the active Niri graphical session.\n' >&2
    exit 1
fi
resolve_installation

controller_pid=""
auth_link=""
proof_transcript=""
query_output=""
failure_stage="initialisation"
installation_succeeded=false

record_unavailable() {
    local diagnostic="$1"
    local profile_tmp
    install -d -m 0700 "$(dirname -- "$profile_file")"
    profile_tmp="$(mktemp)"
    jq -n \
        --arg recorded_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg mode "$install_mode" \
        --arg diagnostic "$diagnostic" \
        '{
            recorded_at: $recorded_at,
            installation: {
                available: false,
                mode: $mode,
                diagnostic: $diagnostic
            }
        }' >"$profile_tmp"
    install -m 0600 "$profile_tmp" "$profile_file"
    rm -f -- "$profile_tmp"
}

cleanup() {
    local failed=false
    if [[ -n "$controller_pid" ]]; then
        if kill -0 "$controller_pid" 2>/dev/null; then
            if ! kill "$controller_pid" 2>/dev/null; then
                printf 'Failed to signal redirected Waldo controller PID %s.\n' "$controller_pid" >&2
                failed=true
            fi
        fi
        for _ in {1..50}; do
            if ! kill -0 "$controller_pid" 2>/dev/null; then
                break
            fi
            sleep 0.1
        done
        if kill -0 "$controller_pid" 2>/dev/null; then
            printf 'Redirected Waldo controller PID %s exceeded its shutdown deadline.\n' \
                "$controller_pid" >&2
            failed=true
            kill -KILL "$controller_pid" 2>/dev/null || true
        fi
        if ! wait "$controller_pid" && [[ "$failed" == false ]]; then
            printf 'Redirected Waldo controller PID %s did not shut down cleanly.\n' \
                "$controller_pid" >&2
            failed=true
        fi
        controller_pid=""
    fi
    if [[ -n "$auth_link" && -L "$auth_link" ]]; then
        if ! rm -f -- "$auth_link"; then
            printf 'Failed to remove temporary Codex authentication link %s.\n' "$auth_link" >&2
            failed=true
        fi
    fi
    if [[ -n "$proof_transcript" ]]; then
        if ! rm -f -- "$proof_transcript"; then
            printf 'Failed to remove temporary Codex proof transcript %s.\n' \
                "$proof_transcript" >&2
            failed=true
        fi
    fi
    if [[ -n "$query_output" ]]; then
        if ! rm -f -- "$query_output"; then
            printf 'Failed to remove temporary Waldo query result %s.\n' "$query_output" >&2
            failed=true
        fi
    fi
    if [[ "$install_mode" == redirected && -n "$redirected_runtime" ]]; then
        if [[ -e "$WALDO_SOCKET_PATH" || -L "$WALDO_SOCKET_PATH" ]]; then
            printf 'Redirected Waldo controller left unexpected socket residue at %s.\n' \
                "$WALDO_SOCKET_PATH" >&2
            failed=true
        fi
        for runtime_directory in "$redirected_runtime/waldo" "$redirected_runtime"; do
            if [[ -e "$runtime_directory" || -L "$runtime_directory" ]]; then
                if ! rmdir -- "$runtime_directory"; then
                    printf 'Redirected Waldo runtime residue remains at %s.\n' \
                        "$runtime_directory" >&2
                    failed=true
                fi
            fi
        done
    fi
    [[ "$failed" == false ]]
}

finish() {
    local status=$?
    local failed_stage="$failure_stage"
    trap - EXIT
    if ! cleanup; then
        status=1
        installation_succeeded=false
        failure_stage="redirected runtime cleanup after $failed_stage"
    fi
    if [[ "$installation_succeeded" != true ]]; then
        record_unavailable "install-local failed during $failure_stage; inspect the preceding diagnostic and rerun after correcting it" || true
    fi
    exit "$status"
}
trap finish EXIT

record_unavailable "installation and installed-binding verification have not completed"

failure_stage="binary installation"
cargo_install=(install --locked --force --root "$cargo_root")
if [[ "$install_mode" == redirected ]]; then
    install -d -m 0700 "$install_root" "$install_home" "$cargo_root" "$codex_home" "$redirected_runtime"
fi
for package in waldo-service waldo-cli waldo-mcp; do
    cargo "${cargo_install[@]}" --path "$repo_root/crates/$package"
done

failure_stage="controller service installation"
write_service_file
if [[ "$install_mode" == redirected ]]; then
    install -d -m 0700 "$redirected_runtime" "$(dirname -- "$WALDO_SOCKET_PATH")"
    service_log="$install_root/waldod.log"
    : >"$service_log"
    chmod 0600 "$service_log"
    "$waldod_bin" >"$service_log" 2>&1 &
    controller_pid=$!
else
    systemctl --user import-environment \
        XDG_RUNTIME_DIR WAYLAND_DISPLAY NIRI_SOCKET DBUS_SESSION_BUS_ADDRESS
    systemctl --user daemon-reload
    systemctl --user enable waldod.service
    systemctl --user restart waldod.service
fi

failure_stage="plugin installation"
install -d -m 0755 "$plugin_home"
rsync -a --delete "$repo_root/plugins/waldo/" "$plugin_home/"
cachebuster="$(date -u +%Y%m%d%H%M%S)"
for client in codex claude; do
    plugin_manifest="$plugin_home/.$client-plugin/plugin.json"
    plugin_manifest_tmp="$(mktemp)"
    jq --arg cachebuster "$cachebuster" --arg client "$client" \
        '.version = ((.version | split("+")[0]) + "+" + $client + "." + $cachebuster)' \
        "$plugin_manifest" >"$plugin_manifest_tmp"
    install -m 0644 "$plugin_manifest_tmp" "$plugin_manifest"
    rm -f -- "$plugin_manifest_tmp"
done

if [[ "$plugin_home" == "$install_home"/* ]]; then
    marketplace_source="./${plugin_home#"$install_home"/}"
else
    marketplace_source="$plugin_home"
fi
write_codex_marketplace

if [[ "$install_mode" == redirected ]]; then
    auth_source="${WALDO_CODEX_AUTH_SOURCE:-$operator_codex_home/auth.json}"
    if [[ ! -f "$auth_source" ]]; then
        printf 'Redirected verification requires an existing Codex login at %s.\n' "$auth_source" >&2
        exit 1
    fi
    auth_link="$codex_home/auth.json"
    if [[ -e "$auth_link" || -L "$auth_link" ]]; then
        printf 'Refusing to replace existing redirected Codex authentication at %s.\n' "$auth_link" >&2
        exit 1
    fi
    ln -s -- "$auth_source" "$auth_link"
fi
run_codex codex plugin add "waldo@$marketplace_name"

if [[ "$install_mode" == canonical ]] && command -v claude >/dev/null; then
    claude_marketplace_root="$(dirname -- "$plugin_home")"
    claude_marketplace_manifest="$claude_marketplace_root/.claude-plugin/marketplace.json"
    install -d -m 0755 "$(dirname -- "$claude_marketplace_manifest")"
    claude_marketplace_tmp="$(mktemp)"
    jq -n --arg path "./$(basename -- "$plugin_home")" --arg name "$marketplace_name" --arg owner "$marketplace_owner" '{
        "name":$name,
        "owner":{"name":$owner},
        "plugins":[{"name":"waldo","source":$path}]
    }' >"$claude_marketplace_tmp"
    install -m 0644 "$claude_marketplace_tmp" "$claude_marketplace_manifest"
    rm -f -- "$claude_marketplace_tmp"
    claude plugin marketplace update "$marketplace_name" 2>/dev/null \
        || claude plugin marketplace add "$claude_marketplace_root"
    claude plugin install "waldo@$marketplace_name"
    claude plugin update "waldo@$marketplace_name"
fi

failure_stage="controller readiness"
query_output="$(mktemp)"
if ! wait_for_controller "$query_output"; then
    if [[ "$install_mode" == canonical ]]; then
        systemctl --user status waldod.service --no-pager >&2 || true
    else
        printf 'Redirected controller log: %s\n' "$service_log" >&2
    fi
    exit 1
fi

failure_stage="installed CLI query"
jq -e '.type == "queried" and (.result.outputs | length) > 0' "$query_output" >/dev/null

failure_stage="installed stock-Codex plugin and first-image proof"
mapfile -t installed_plugin_manifests < <(
    find "$codex_home/plugins/cache/$marketplace_name/waldo" -path '*/.codex-plugin/plugin.json' \
        | sort
)
if [[ ${#installed_plugin_manifests[@]} -eq 0 ]]; then
    printf 'Codex installed no waldo plugin beneath %s.\n' "$codex_home/plugins/cache/$marketplace_name/waldo" >&2
    exit 1
fi
installed_plugin_manifest="${installed_plugin_manifests[${#installed_plugin_manifests[@]}-1]}"
installed_plugin_root="$(dirname -- "$(dirname -- "$installed_plugin_manifest")")"
installed_mcp_manifest="$installed_plugin_root/.mcp.json"
if [[ ! -f "$installed_mcp_manifest" ]]; then
    printf 'Installed plugin proof is missing %s.\n' "$installed_mcp_manifest" >&2
    exit 1
fi
cmp -s "$plugin_home/.mcp.json" "$installed_mcp_manifest" || {
    printf 'Installed Codex MCP manifest bytes do not match the candidate plugin.\n' >&2
    exit 1
}

proof_transcript="$(mktemp)"
chmod 0600 "$proof_transcript"
proof_prompt='Query Waldo to choose one available output, call Waldo Observe exactly once on that output, then reply with MCP_IMAGE_PROOF_OK. Do not call Act or any mutating tool.'
proof_workdir="$repo_root"
if [[ "$install_mode" == redirected ]]; then
    proof_workdir="$install_root"
fi
run_codex codex exec \
    --json \
    --ephemeral \
    --sandbox read-only \
    --cd "$proof_workdir" \
    --skip-git-repo-check \
    "$proof_prompt" </dev/null >"$proof_transcript"

proof_summary="$(jq -s '
    . as $events
    | [$events[]
        | select(
            .type == "item.completed"
            and .item.type == "mcp_tool_call"
            and .item.server == "waldo"
            and .item.tool == "observe"
        )] as $observe_calls
    | [$observe_calls[]
        | .item.result
        | (., (.. | strings | select(startswith("{")) | fromjson?))
        | objects
        | select(
            any(.content[]?;
                .type == "image"
                and .mimeType == "image/png"
                and (.data | type == "string")
                and (.data | length > 0)
            )
            and ((.structuredContent // .structured_content).observation.image.delivered_as_content == true)
        )] as $image_results
    | {
        observe_calls: ($observe_calls | length),
        image_results: ($image_results | length),
        mutating_calls: ([$events[]
            | select(
                .type == "item.completed"
                and .item.type == "mcp_tool_call"
                and .item.server == "waldo"
                and (.item.tool == "act" or .item.tool == "stop" or .item.tool == "handover")
            )] | length),
        completion_markers: ([$events[]
            | select(
                .type == "item.completed"
                and .item.type == "agent_message"
                and (.item.text | contains("MCP_IMAGE_PROOF_OK"))
            )] | length)
    }
' "$proof_transcript")"
if ! jq -e '
    .observe_calls == 1
    and .image_results == 1
    and .mutating_calls == 0
    and .completion_markers >= 1
' <<<"$proof_summary" >/dev/null; then
    printf 'Stock Codex did not prove plugin loading and one structured MCP image: %s\n' \
        "$proof_summary" >&2
    exit 1
fi

failure_stage="verified environment recording"
recorded_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
source_commit="$(git -C "$repo_root" rev-parse HEAD)"
source_tree_clean=false
if [[ -z "$(git -C "$repo_root" status --porcelain)" ]]; then
    source_tree_clean=true
fi
profile_tmp="$(mktemp)"
jq \
    --arg recorded_at "$recorded_at" \
    --arg mode "$install_mode" \
    --arg source_commit "$source_commit" \
    --argjson source_tree_clean "$source_tree_clean" \
    --arg codex_version "$(codex --version)" \
    --arg plugin_manifest "$installed_plugin_manifest" \
    --arg plugin_manifest_sha256 "$(sha256sum "$installed_plugin_manifest" | cut -d' ' -f1)" \
    --arg mcp_binary "$mcp_bin" \
    --arg mcp_binary_sha256 "$(sha256sum "$mcp_bin" | cut -d' ' -f1)" \
    --argjson proof "$proof_summary" \
    '{
        recorded_at: $recorded_at,
        installation: {
            available: true,
            mode: $mode,
            source_commit: $source_commit,
            source_tree_clean: $source_tree_clean,
            plugin_loaded: true,
            mcp_image_delivery: true,
            codex_version: $codex_version,
            plugin_manifest: {path: $plugin_manifest, sha256: $plugin_manifest_sha256},
            mcp_binary: {path: $mcp_binary, sha256: $mcp_binary_sha256},
            proof: $proof
        },
        profile: .result.profile,
        capabilities: .result.capabilities,
        outputs: .result.outputs,
        keyboard_layouts: .result.keyboard_layouts,
        active_keyboard_layout: .result.active_keyboard_layout
    }' "$query_output" >"$profile_tmp"
install -m 0600 "$profile_tmp" "$profile_file"
rm -f -- "$profile_tmp"

installation_succeeded=true
printf 'Installed Waldo, proved stock-Codex plugin loading and first MCP image delivery, and recorded %s\n' \
    "$profile_file"
