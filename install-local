#!/usr/bin/env bash
set -eEuo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# These steps can be sourced to inspect configuration, generate artefacts and
# judge proof transcripts without installing binaries or changing a running
# service.
resolve_installation() {
    operator_home="$HOME"
    operator_codex_home="${CODEX_HOME:-$operator_home/.codex}"
    install_root="${WALDO_INSTALL_ROOT:-}"
    install_mode="canonical"
    marketplace_name="${WALDO_MARKETPLACE_NAME:-personal}"
    marketplace_owner="${WALDO_MARKETPLACE_OWNER:-BFJ Concerns}"

    if [[ -n "$install_root" ]]; then
        install_mode="redirected"
        install_root="$(realpath -m -- "$install_root")"
        case "$install_root" in
            /|"$operator_home"|"$repo_root")
                printf 'WALDO_INSTALL_ROOT must name a dedicated disposable directory.\n' >&2
                return 1
                ;;
        esac
        install_home="$install_root/home"
        cargo_root="${WALDO_CARGO_INSTALL_ROOT:-$install_root/cargo}"
        plugin_home="${WALDO_PLUGIN_HOME:-$install_home/plugins/waldo}"
        marketplace="${WALDO_MARKETPLACE:-$install_home/.agents/plugins/marketplace.json}"
        service_file="${WALDO_SERVICE_FILE:-$install_home/.config/systemd/user/waldod.service}"
        profile_file="${WALDO_PROFILE_FILE:-$install_root/state/waldo/environment.json}"
        codex_home="${WALDO_CODEX_HOME:-$install_root/codex}"
        runtime_tag="$(printf '%s' "$install_root" | sha256sum | cut -c1-12)"
        redirected_runtime="${WALDO_RUNTIME_DIR:-$XDG_RUNTIME_DIR/waldo-install-$runtime_tag}"
        # The rehearsal default is an explicit override for every child,
        # including MCP. Canonical resolution is left entirely to Settings.
        if [[ ! -v WALDO_SOCKET_PATH ]]; then
            export WALDO_SOCKET_PATH="$redirected_runtime/waldo/controller.sock"
        fi
        export XDG_CONFIG_HOME="$install_home/.config"
    else
        install_home="$operator_home"
        cargo_root="${WALDO_CARGO_INSTALL_ROOT:-${CARGO_INSTALL_ROOT:-${CARGO_HOME:-$operator_home/.cargo}}}"
        plugin_home="${WALDO_PLUGIN_HOME:-$operator_home/plugins/waldo}"
        marketplace="${WALDO_MARKETPLACE:-$operator_home/.agents/plugins/marketplace.json}"
        service_file="${WALDO_SERVICE_FILE:-$operator_home/.config/systemd/user/waldod.service}"
        profile_file="${WALDO_PROFILE_FILE:-${XDG_STATE_HOME:-$operator_home/.local/state}/waldo/environment.json}"
        codex_home="$operator_codex_home"
        redirected_runtime=""
    fi
    cargo_root="$(realpath -m -- "$cargo_root")"
    bin_dir="$cargo_root/bin"
    waldod_bin="$bin_dir/waldod"
    waldo_bin="$bin_dir/waldo"
    mcp_bin="$bin_dir/waldo-mcp"
    # Claude Code registers a directory marketplace by its root, which carries
    # the manifest and the plugin directories it lists.
    claude_marketplace_root="$(realpath -m -- "$(dirname -- "$plugin_home")")"
    claude_marketplace="$claude_marketplace_root/.claude-plugin/marketplace.json"
}

# Claude Code is the supported agent and is required. Codex registration and
# its proof are best-effort: they run only when codex is on PATH.
require_commands() {
    local command
    for command in cargo claude git jq realpath rsync sha256sum systemctl; do
        command -v "$command" >/dev/null || {
            printf 'Waldo installation requires %s on PATH.\n' "$command" >&2
            return 1
        }
    done
}

# systemd expands specifiers in these directives. Quote the entire argument
# and escape input rather than letting paths become unit syntax.
systemd_argument() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//%/%%}"
    value="${value//$'\n'/\\n}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\t'/\\t}"
    printf '"%s"' "$value"
}

write_service_file() {
    local line
    install -d -m 0755 "$(dirname -- "$service_file")"
    while IFS= read -r line; do
        if [[ "$line" == ExecStart=* ]]; then
            printf 'ExecStart='
            # The executable path does not undergo environment expansion.
            systemd_argument "$waldod_bin"
            printf '\n'
            if [[ -v WALDO_SOCKET_PATH ]]; then
                printf 'Environment='
                systemd_argument "WALDO_SOCKET_PATH=$WALDO_SOCKET_PATH"
                printf '\n'
            fi
            if [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
                printf 'Environment='
                systemd_argument "XDG_CONFIG_HOME=$XDG_CONFIG_HOME"
                printf '\n'
            fi
        else
            printf '%s\n' "$line"
        fi
    done <"$repo_root/packaging/waldod.service" >"$service_file"
    chmod 0644 "$service_file"
}

# Copy the plugin source for the agents' marketplaces. The copy's MCP
# manifests name the resolved binary, so an agent launches it without PATH
# setup, and its plugin manifests carry a fresh build tag so each agent
# installs the new copy rather than a cached one.
install_plugin_copy() {
    local manifest manifest_tmp cachebuster client
    install -d -m 0755 "$plugin_home"
    rsync -a --delete "$repo_root/plugins/waldo/" "$plugin_home/"
    for manifest in .mcp.json .mcp.claude.json; do
        manifest_tmp="$(mktemp)"
        jq --arg command "$mcp_bin" '.mcpServers.waldo.command = $command' \
            "$plugin_home/$manifest" >"$manifest_tmp"
        install -m 0644 "$manifest_tmp" "$plugin_home/$manifest"
        rm -f -- "$manifest_tmp"
    done
    cachebuster="$(date -u +%Y%m%d%H%M%S)"
    for client in codex claude; do
        manifest="$plugin_home/.$client-plugin/plugin.json"
        manifest_tmp="$(mktemp)"
        jq --arg cachebuster "$cachebuster" --arg client "$client" \
            '.version = ((.version | split("+")[0]) + "+" + $client + "." + $cachebuster)' \
            "$manifest" >"$manifest_tmp"
        install -m 0644 "$manifest_tmp" "$manifest"
        rm -f -- "$manifest_tmp"
    done
}

# A marketplace manifest is shared with other plugins. Merge into it: the
# name, owner and waldo entry are Waldo's to set; every other entry and key
# survives. The optional third argument is an agent-specific jq filter
# applied to the merged manifest. Success means the merge succeeded, and a
# failed merge leaves the manifest untouched: the writer may run where
# errexit is suspended, so it guards its own steps.
write_marketplace() {
    local manifest="$1" entry="$2" extra_filter="${3:-.}"
    local manifest_tmp filter
    install -d -m 0755 "$(dirname -- "$manifest")" || return 1
    manifest_tmp="$(mktemp)" || return 1
    filter='.name = $name
        | .owner = {"name": $owner}
        | .plugins = ((.plugins // []) | map(select(.name != "waldo")) + [$entry])
        | '"$extra_filter"
    if [[ -f "$manifest" ]]; then
        jq --arg name "$marketplace_name" --arg owner "$marketplace_owner" \
            --argjson entry "$entry" "$filter" "$manifest" >"$manifest_tmp"
    else
        jq -n --arg name "$marketplace_name" --arg owner "$marketplace_owner" \
            --argjson entry "$entry" "$filter" >"$manifest_tmp"
    fi || {
        rm -f -- "$manifest_tmp"
        return 1
    }
    install -m 0644 "$manifest_tmp" "$manifest" || {
        rm -f -- "$manifest_tmp"
        return 1
    }
    rm -f -- "$manifest_tmp"
}

write_codex_marketplace() {
    local marketplace_source entry
    if [[ "$plugin_home" == "$install_home"/* ]]; then
        marketplace_source="./${plugin_home#"$install_home"/}"
    else
        marketplace_source="$plugin_home"
    fi
    entry="$(jq -n --arg source "$marketplace_source" '{
        "name": "waldo",
        "source": {"source": "local", "path": $source},
        "policy": {"installation": "AVAILABLE", "authentication": "ON_INSTALL"},
        "category": "Productivity"
    }')" || return 1
    write_marketplace "$marketplace" "$entry" \
        '.interface = (.interface // {"displayName": "Personal"})'
}

write_claude_marketplace() {
    local entry
    entry="$(jq -n --arg source "./$(basename -- "$plugin_home")" '{"name": "waldo", "source": $source}')" || return 1
    write_marketplace "$claude_marketplace" "$entry"
}

# Codex keeps its login under CODEX_HOME, so a rehearsal redirects its home
# and links the operator's login in. Claude Code's login is never copied:
# both modes run it as the operator, and the rehearsal loads the candidate
# plugin for one session with --plugin-dir instead of registering it.
run_codex() {
    if [[ "$install_mode" == redirected ]]; then
        env HOME="$install_home" CODEX_HOME="$codex_home" PATH="$bin_dir:$PATH" "$@"
    else
        env PATH="$bin_dir:$PATH" "$@"
    fi
}

run_claude() {
    env PATH="$bin_dir:$PATH" "$@"
}

wait_for_controller() {
    local query_destination="$1"
    for _ in {1..50}; do
        if "$waldo_bin" query >"$query_destination" 2>/dev/null \
            && jq -e '.type == "queried"' "$query_destination" >/dev/null; then
            return 0
        fi
        sleep 0.1
    done
    printf 'Waldo controller did not answer the installed CLI query.\n' >&2
    return 1
}

# The proof turn: one real headless turn of the agent with the plugin loaded,
# judged from its transcript. The judge counts tool results, never the
# model's words: an image content block delivered inside an Observe tool
# result, with the observation's delivered_as_content flag, is the proof;
# the completion marker only shows the turn ran to its end.
proof_prompt='Query Waldo to choose one available output, call Waldo Observe exactly once on that output, then reply with MCP_IMAGE_PROOF_OK. Do not call Act or any mutating tool.'

# Claude Code's stream-json transcript: the init event lists loaded plugins
# and connected MCP servers, tool calls are assistant tool_use blocks named
# mcp__plugin_<plugin>_<server>__<tool>, and each tool result is a user event
# whose tool_use_result carries the content blocks and structured content.
# $2 names the plugin source the turn must have loaded: waldo@<marketplace>
# for a registered plugin, waldo@inline for a --plugin-dir load.
summarise_claude_turn() {
    local transcript="$1" plugin_source="$2"
    jq -s --arg plugin_source "$plugin_source" '
        . as $events
        | [$events[] | select(.type == "system" and .subtype == "init")] as $inits
        | [$events[] | select(.type == "assistant") | .message.content[]? | select(.type == "tool_use")] as $tool_uses
        | [$tool_uses[] | select(.name == "mcp__plugin_waldo_waldo__observe") | .id] as $observe_ids
        | [$events[]
            | select(.type == "user")
            | select(any(.message.content[]?;
                .type == "tool_result" and (.tool_use_id as $id | any($observe_ids[]; . == $id))))
            | .tool_use_result
            | objects
            | select(
                any(.content[]?;
                    .type == "image"
                    and .source.type == "base64"
                    and (.source.data | type == "string")
                    and (.source.data | length > 0)
                )
                and .structuredContent.observation.image.delivered_as_content == true
            )] as $image_results
        | {
            plugin_source: $plugin_source,
            plugins_loaded: ([$inits[].plugins[]? | select(.name == "waldo" and .source == $plugin_source)] | length),
            plugin_paths: [$inits[].plugins[]? | select(.name == "waldo" and .source == $plugin_source) | .path],
            servers_connected: ([$inits[].mcp_servers[]? | select(.name == "plugin:waldo:waldo" and .status == "connected")] | length),
            observe_calls: ($observe_ids | length),
            image_results: ($image_results | length),
            mutating_calls: ([$tool_uses[]
                | select(.name == "mcp__plugin_waldo_waldo__act" or .name == "mcp__plugin_waldo_waldo__stop")] | length),
            completion_markers: ([$events[]
                | select(.type == "result" and ((.result // "") | contains("MCP_IMAGE_PROOF_OK")))] | length)
        }' "$transcript"
}

claude_turn_proves() {
    jq -e '
        .plugins_loaded == 1
        and .servers_connected == 1
        and .observe_calls == 1
        and .image_results == 1
        and .mutating_calls == 0
        and .completion_markers >= 1
    ' <<<"$1" >/dev/null
}

# Codex's exec --json transcript: MCP tool calls and their results arrive
# as item.completed events, the result carried as an object or as JSON text.
summarise_codex_turn() {
    local transcript="$1"
    jq -s '
        . as $events
        | [$events[]
            | select(
                .type == "item.completed"
                and .item.type == "mcp_tool_call"
                and .item.server == "waldo"
                and .item.tool == "observe"
            )] as $observe_calls
        | [$observe_calls[]
            | .item.result
            | (., (.. | strings | select(startswith("{")) | fromjson?))
            | objects
            | select(
                any(.content[]?;
                    .type == "image"
                    and .mimeType == "image/png"
                    and (.data | type == "string")
                    and (.data | length > 0)
                )
                and ((.structuredContent // .structured_content).observation.image.delivered_as_content == true)
            )] as $image_results
        | {
            observe_calls: ($observe_calls | length),
            image_results: ($image_results | length),
            mutating_calls: ([$events[]
                | select(
                    .type == "item.completed"
                    and .item.type == "mcp_tool_call"
                    and .item.server == "waldo"
                    and (.item.tool == "act" or .item.tool == "stop")
                )] | length),
            completion_markers: ([$events[]
                | select(
                    .type == "item.completed"
                    and .item.type == "agent_message"
                    and (.item.text | contains("MCP_IMAGE_PROOF_OK"))
                )] | length)
        }' "$transcript"
}

codex_turn_proves() {
    jq -e '
        .observe_calls == 1
        and .image_results == 1
        and .mutating_calls == 0
        and .completion_markers >= 1
    ' <<<"$1" >/dev/null
}

# Installation entry point. Sourcing exposes only the steps above.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
fi

require_commands

if [[ -z "${XDG_RUNTIME_DIR:-}" || -z "${WAYLAND_DISPLAY:-}" || -z "${NIRI_SOCKET:-}" ]]; then
    printf 'Run the installer inside the active Niri graphical session.\n' >&2
    exit 1
fi
resolve_installation

controller_pid=""
auth_link=""
proof_dir=""
query_output=""
failure_stage="initialisation"
installation_succeeded=false

record_unavailable() {
    local diagnostic="$1"
    local profile_tmp
    install -d -m 0700 "$(dirname -- "$profile_file")"
    profile_tmp="$(mktemp)"
    jq -n \
        --arg recorded_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg mode "$install_mode" \
        --arg diagnostic "$diagnostic" \
        '{
            recorded_at: $recorded_at,
            installation: {
                available: false,
                mode: $mode,
                diagnostic: $diagnostic
            }
        }' >"$profile_tmp"
    install -m 0600 "$profile_tmp" "$profile_file"
    rm -f -- "$profile_tmp"
}

cleanup() {
    local failed=false
    if [[ -n "$controller_pid" ]]; then
        if kill -0 "$controller_pid" 2>/dev/null; then
            if ! kill "$controller_pid" 2>/dev/null; then
                printf 'Failed to signal redirected Waldo controller PID %s.\n' "$controller_pid" >&2
                failed=true
            fi
        fi
        for _ in {1..50}; do
            if ! kill -0 "$controller_pid" 2>/dev/null; then
                break
            fi
            sleep 0.1
        done
        if kill -0 "$controller_pid" 2>/dev/null; then
            printf 'Redirected Waldo controller PID %s exceeded its shutdown deadline.\n' \
                "$controller_pid" >&2
            failed=true
            kill -KILL "$controller_pid" 2>/dev/null || true
        fi
        if ! wait "$controller_pid" && [[ "$failed" == false ]]; then
            printf 'Redirected Waldo controller PID %s did not shut down cleanly.\n' \
                "$controller_pid" >&2
            failed=true
        fi
        controller_pid=""
    fi
    if [[ -n "$auth_link" && -L "$auth_link" ]]; then
        if ! rm -f -- "$auth_link"; then
            printf 'Failed to remove temporary Codex authentication link %s.\n' "$auth_link" >&2
            failed=true
        fi
    fi
    if [[ -n "$proof_dir" ]]; then
        if ! rm -rf -- "$proof_dir"; then
            printf 'Failed to remove temporary proof transcripts %s.\n' "$proof_dir" >&2
            failed=true
        fi
    fi
    if [[ -n "$query_output" ]]; then
        if ! rm -f -- "$query_output"; then
            printf 'Failed to remove temporary Waldo query result %s.\n' "$query_output" >&2
            failed=true
        fi
    fi
    if [[ "$install_mode" == redirected && -n "$redirected_runtime" ]]; then
        if [[ -e "$WALDO_SOCKET_PATH" || -L "$WALDO_SOCKET_PATH" ]]; then
            printf 'Redirected Waldo controller left unexpected socket residue at %s.\n' \
                "$WALDO_SOCKET_PATH" >&2
            failed=true
        fi
        for runtime_directory in "$redirected_runtime/waldo" "$redirected_runtime"; do
            if [[ -e "$runtime_directory" || -L "$runtime_directory" ]]; then
                if ! rmdir -- "$runtime_directory"; then
                    printf 'Redirected Waldo runtime residue remains at %s.\n' \
                        "$runtime_directory" >&2
                    failed=true
                fi
            fi
        done
    fi
    [[ "$failed" == false ]]
}

finish() {
    local status=$?
    local failed_stage="$failure_stage"
    trap - EXIT
    if ! cleanup; then
        status=1
        installation_succeeded=false
        failure_stage="redirected runtime cleanup after $failed_stage"
    fi
    if [[ "$installation_succeeded" != true ]]; then
        record_unavailable "install-local failed during $failure_stage; inspect the preceding diagnostic and rerun after correcting it" || true
    fi
    exit "$status"
}
trap finish EXIT

record_unavailable "installation and installed-binding verification have not completed"

failure_stage="binary installation"
cargo_install=(install --locked --force --root "$cargo_root")
if [[ "$install_mode" == redirected ]]; then
    install -d -m 0700 "$install_root" "$install_home" "$cargo_root" "$codex_home" "$redirected_runtime"
fi
for package in waldo-service waldo-cli waldo-mcp; do
    cargo "${cargo_install[@]}" --path "$repo_root/crates/$package"
done

failure_stage="controller service installation"
write_service_file
if [[ "$install_mode" == redirected ]]; then
    install -d -m 0700 "$redirected_runtime" "$(dirname -- "$WALDO_SOCKET_PATH")"
    service_log="$install_root/waldod.log"
    : >"$service_log"
    chmod 0600 "$service_log"
    "$waldod_bin" >"$service_log" 2>&1 &
    controller_pid=$!
else
    systemctl --user import-environment \
        XDG_RUNTIME_DIR WAYLAND_DISPLAY NIRI_SOCKET DBUS_SESSION_BUS_ADDRESS
    systemctl --user daemon-reload
    systemctl --user enable waldod.service
    systemctl --user restart waldod.service
fi

failure_stage="plugin installation"
install_plugin_copy

# Registration changes the operator's Claude Code configuration, so only a
# canonical install performs it; a rehearsal proves the candidate through a
# one-session --plugin-dir load below.
failure_stage="Claude Code plugin registration"
if [[ "$install_mode" == canonical ]]; then
    write_claude_marketplace
    registered_root="$(claude plugin marketplace list --json \
        | jq -r --arg name "$marketplace_name" '.[] | select(.name == $name) | .installLocation // empty')"
    if [[ -z "$registered_root" ]]; then
        claude plugin marketplace add "$claude_marketplace_root"
    elif [[ "$(realpath -m -- "$registered_root")" != "$claude_marketplace_root" ]]; then
        printf 'Claude Code already has a marketplace named %s at %s; set WALDO_MARKETPLACE_NAME to another name or WALDO_PLUGIN_HOME beneath that root.\n' \
            "$marketplace_name" "$registered_root" >&2
        exit 1
    else
        claude plugin marketplace update "$marketplace_name"
    fi
    claude plugin install "waldo@$marketplace_name"
    claude plugin update "waldo@$marketplace_name"
fi

failure_stage="controller readiness"
query_output="$(mktemp)"
if ! wait_for_controller "$query_output"; then
    if [[ "$install_mode" == canonical ]]; then
        systemctl --user status waldod.service --no-pager >&2 || true
    else
        printf 'Redirected controller log: %s\n' "$service_log" >&2
    fi
    exit 1
fi

failure_stage="installed CLI query"
jq -e '.type == "queried" and (.result.outputs | length) > 0' "$query_output" >/dev/null

failure_stage="Claude Code plugin and first-image proof"
proof_dir="$(mktemp -d)"
chmod 0700 "$proof_dir"
# The turn runs from an empty private directory so no project guidance or
# project MCP configuration joins it, with the built-in tools removed and
# only the two read-only Waldo tools permitted; anything else is denied.
install -d -m 0700 "$proof_dir/cwd"
if [[ "$install_mode" == canonical ]]; then
    claude_plugin_source="waldo@$marketplace_name"
    claude_session=(--setting-sources user)
else
    claude_plugin_source="waldo@inline"
    claude_session=(--setting-sources local --plugin-dir "$plugin_home")
fi
claude_transcript="$proof_dir/claude.jsonl"
(
    cd "$proof_dir/cwd"
    run_claude claude -p "$proof_prompt" \
        --output-format stream-json \
        --verbose \
        --no-session-persistence \
        --tools "" \
        --allowedTools mcp__plugin_waldo_waldo__query mcp__plugin_waldo_waldo__observe \
        --permission-prompts none \
        "${claude_session[@]}" </dev/null >"$claude_transcript"
)
claude_summary="$(summarise_claude_turn "$claude_transcript" "$claude_plugin_source")"
if ! claude_turn_proves "$claude_summary"; then
    printf 'Claude Code did not prove plugin loading and one in-turn MCP image: %s\n' \
        "$claude_summary" >&2
    exit 1
fi

# Best-effort: a failure here is recorded in the environment file and
# reported, never fatal. Every step names its own diagnostic, because a
# function called under `if` runs with errexit suspended.
codex_registration_and_proof() {
    codex_diagnostic=""
    codex_summary="null"
    installed_codex_manifest=""
    if [[ "$install_mode" == redirected ]]; then
        local auth_source="${WALDO_CODEX_AUTH_SOURCE:-$operator_codex_home/auth.json}"
        if [[ ! -f "$auth_source" ]]; then
            codex_diagnostic="redirected Codex proof needs an existing Codex login at $auth_source"
            return 1
        fi
        local auth_candidate="$codex_home/auth.json"
        if [[ -e "$auth_candidate" || -L "$auth_candidate" ]]; then
            codex_diagnostic="refusing to replace existing redirected Codex authentication at $auth_candidate"
            return 1
        fi
        ln -s -- "$auth_source" "$auth_candidate" || {
            codex_diagnostic="could not link the Codex login into $codex_home"
            return 1
        }
        # Cleanup removes only a link this run created.
        auth_link="$auth_candidate"
    fi
    write_codex_marketplace || {
        codex_diagnostic="could not write the Codex marketplace $marketplace"
        return 1
    }
    run_codex codex plugin add "waldo@$marketplace_name" || {
        codex_diagnostic="codex plugin add waldo@$marketplace_name failed"
        return 1
    }
    local manifests
    mapfile -t manifests < <(
        find "$codex_home/plugins/cache/$marketplace_name/waldo" -path '*/.codex-plugin/plugin.json' 2>/dev/null \
            | sort
    )
    if [[ ${#manifests[@]} -eq 0 ]]; then
        codex_diagnostic="Codex installed no waldo plugin beneath $codex_home/plugins/cache/$marketplace_name/waldo"
        return 1
    fi
    installed_codex_manifest="${manifests[${#manifests[@]}-1]}"
    local installed_root
    installed_root="$(dirname -- "$(dirname -- "$installed_codex_manifest")")"
    cmp -s "$plugin_home/.mcp.json" "$installed_root/.mcp.json" || {
        codex_diagnostic="installed Codex MCP manifest bytes do not match the candidate plugin"
        return 1
    }
    local transcript="$proof_dir/codex.jsonl"
    run_codex codex exec \
        --json \
        --ephemeral \
        --sandbox read-only \
        --cd "$proof_dir/cwd" \
        --skip-git-repo-check \
        "$proof_prompt" </dev/null >"$transcript" || {
        codex_diagnostic="codex exec failed"
        return 1
    }
    local summary
    summary="$(summarise_codex_turn "$transcript")" || {
        codex_diagnostic="Codex transcript could not be summarised"
        return 1
    }
    codex_summary="$summary"
    codex_turn_proves "$codex_summary" || {
        codex_diagnostic="Codex did not prove plugin loading and one structured MCP image"
        return 1
    }
}

failure_stage="best-effort Codex registration and proof"
codex_record='{"present": false}'
if command -v codex >/dev/null; then
    if codex_registration_and_proof; then
        codex_record="$(jq -n \
            --arg version "$(codex --version)" \
            --arg plugin_manifest "$installed_codex_manifest" \
            --arg plugin_manifest_sha256 "$(sha256sum "$installed_codex_manifest" | cut -d' ' -f1)" \
            --argjson proof "$codex_summary" \
            '{
                present: true,
                proved: true,
                version: $version,
                plugin_manifest: {path: $plugin_manifest, sha256: $plugin_manifest_sha256},
                proof: $proof
            }')"
    else
        printf 'Codex (best-effort) did not complete: %s\n' "$codex_diagnostic" >&2
        codex_record="$(jq -n \
            --arg version "$(codex --version)" \
            --arg diagnostic "$codex_diagnostic" \
            --argjson proof "$codex_summary" \
            '{present: true, proved: false, version: $version, diagnostic: $diagnostic, proof: $proof}')"
    fi
fi

failure_stage="verified environment recording"
recorded_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
source_commit="$(git -C "$repo_root" rev-parse HEAD)"
source_tree_clean=false
if [[ -z "$(git -C "$repo_root" status --porcelain)" ]]; then
    source_tree_clean=true
fi
profile_tmp="$(mktemp)"
jq \
    --arg recorded_at "$recorded_at" \
    --arg mode "$install_mode" \
    --arg source_commit "$source_commit" \
    --argjson source_tree_clean "$source_tree_clean" \
    --arg plugin_home "$plugin_home" \
    --arg mcp_binary "$mcp_bin" \
    --arg mcp_binary_sha256 "$(sha256sum "$mcp_bin" | cut -d' ' -f1)" \
    --arg claude_version "$(claude --version)" \
    --argjson claude_proof "$claude_summary" \
    --argjson codex "$codex_record" \
    '{
        recorded_at: $recorded_at,
        installation: {
            available: true,
            mode: $mode,
            source_commit: $source_commit,
            source_tree_clean: $source_tree_clean,
            plugin_loaded: true,
            mcp_image_delivery: true,
            plugin_home: $plugin_home,
            mcp_binary: {path: $mcp_binary, sha256: $mcp_binary_sha256},
            agents: {
                claude: {version: $claude_version, proof: $claude_proof},
                codex: $codex
            }
        },
        profile: .result.profile,
        capabilities: .result.capabilities,
        outputs: .result.outputs,
        keyboard_layouts: .result.keyboard_layouts,
        active_keyboard_layout: .result.active_keyboard_layout
    }' "$query_output" >"$profile_tmp"
install -m 0600 "$profile_tmp" "$profile_file"
rm -f -- "$profile_tmp"

installation_succeeded=true
printf 'Installed Waldo, proved plugin loading and first in-turn MCP image delivery in Claude Code, and recorded %s\n' \
    "$profile_file"
